#!/usr/bin/env bash
# Defensive pre-push hook: mirrors CI for the Bun + Biome + TS monorepo.
#
# Runs lint + typecheck + tests when the scaffolding is present, and no-ops
# gracefully with a message otherwise. The product scaffolding (package.json,
# build scripts, tests) is added later per the plan; this hook starts enforcing
# the moment those land. Activate once per clone with:
#   git config core.hooksPath scripts/hooks
set -euo pipefail

# push_only_deletes: true when every ref line git hands pre-push on stdin,
# `<local ref> <local sha> <remote ref> <remote sha>`, deletes a remote ref.
# A delete carries an all-zero local sha (40 zeros, or 64 in a SHA-256
# repository) and delivers no commit for any check to read.
#
# False, so the checks run, when stdin is a terminal (the hook run by hand),
# when it carries no ref lines, and when it stays open for
# HOOK_STDIN_WAIT_SECONDS (default 5) with no next line. Git writes its lines
# and closes stdin at once, so a real push never waits.
#
# The same function github-repo-setup's hooks library ships, inline because
# this hook sources no library.
push_only_deletes() {
  local wait_s="${HOOK_STDIN_WAIT_SECONDS:-5}" line local_ref local_sha rc deletes=0 others=0
  HOOK_PUSH_REFS=''
  [ -t 0 ] && return 1
  while :; do
    rc=0
    IFS= read -r -t "$wait_s" line || rc=$?
    [ "$rc" -eq 0 ] || break
    HOOK_PUSH_REFS+="$line"$'\n'
    read -r local_ref local_sha _ <<<"$line"
    [ -n "$local_ref" ] || continue
    if [[ "$local_sha" =~ ^0+$ ]]; then
      deletes=$((deletes + 1))
    else
      others=$((others + 1))
    fi
  done
  # read returns above 128 on a timeout and 1 at end of input.
  [ "$rc" -le 128 ] && [ "$deletes" -gt 0 ] && [ "$others" -eq 0 ]
}

if push_only_deletes; then
  echo "Nothing to check: the push only deletes."
  exit 0
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-push: bun not installed; skipping local CI mirror"
  exit 0
fi

if [ ! -f package.json ]; then
  echo "pre-push: no package.json yet; skipping local CI mirror"
  exit 0
fi

# Dependency-free probe for a defined npm script.
has_script() {
  grep -Eq "\"$1\"[[:space:]]*:" package.json 2>/dev/null
}

for step in lint typecheck; do
  if has_script "$step"; then
    echo "pre-push: bun run $step"
    bun run "$step"
  else
    echo "pre-push: no '$step' script defined yet; skipping"
  fi
done

if has_script test; then
  echo "pre-push: bun run test"
  bun run test
elif [ -n "$(git ls-files '*.test.ts' '*.test.tsx' '*.spec.ts' '*.test.js' 2>/dev/null)" ]; then
  echo "pre-push: bun test"
  bun test
else
  echo "pre-push: no test script or test files yet; skipping tests"
fi

echo "pre-push: all present checks passed."
