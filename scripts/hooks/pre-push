#!/usr/bin/env bash
# Defensive pre-push hook: mirrors CI for the Bun + Biome + TS monorepo.
#
# Runs lint + typecheck + tests when the scaffolding is present, and no-ops
# gracefully with a message otherwise. The product scaffolding (package.json,
# build scripts, tests) is added later per the plan; this hook starts enforcing
# the moment those land. Activate once per clone with:
#   git config core.hooksPath scripts/hooks
set -euo pipefail

# git writes one `<local ref> <local sha> <remote ref> <remote sha>` line per
# pushed ref on stdin, then closes it. A deleted ref has an all-zero local sha
# (40 or 64 digits) and delivers no commit, so a push of only deletes has
# nothing to check. A stdin nobody closes would park a plain read, so each read
# is bounded; a timeout, a terminal (the hook run by hand), or no ref lines at
# all runs every check.
PRE_PUSH_STDIN_TIMEOUT="${PRE_PUSH_STDIN_TIMEOUT:-5}"

push_only_deletes() {
  local local_sha saw_ref=false
  [ ! -t 0 ] || return 1
  while true; do
    if read -r -t "$PRE_PUSH_STDIN_TIMEOUT" _ local_sha _; then
      [ -n "$local_sha" ] || continue
    elif [ $? -gt 128 ]; then
      echo "pre-push: stdin stayed open for ${PRE_PUSH_STDIN_TIMEOUT}s; running every check" >&2
      return 1
    elif [ -z "$local_sha" ]; then
      break
    fi
    [[ $local_sha =~ ^0+$ ]] || return 1
    saw_ref=true
  done
  [ "$saw_ref" = true ]
}

if push_only_deletes; then
  echo "pre-push: nothing to check: the push only deletes"
  exit 0
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-push: bun not installed; skipping local CI mirror"
  exit 0
fi

if [ ! -f package.json ]; then
  echo "pre-push: no package.json yet; skipping local CI mirror"
  exit 0
fi

# Dependency-free probe for a defined npm script.
has_script() {
  grep -Eq "\"$1\"[[:space:]]*:" package.json 2>/dev/null
}

for step in lint typecheck; do
  if has_script "$step"; then
    echo "pre-push: bun run $step"
    bun run "$step"
  else
    echo "pre-push: no '$step' script defined yet; skipping"
  fi
done

if has_script test; then
  echo "pre-push: bun run test"
  bun run test
elif [ -n "$(git ls-files '*.test.ts' '*.test.tsx' '*.spec.ts' '*.test.js' 2>/dev/null)" ]; then
  echo "pre-push: bun test"
  bun test
else
  echo "pre-push: no test script or test files yet; skipping tests"
fi

echo "pre-push: all present checks passed."
